{
  "name": "tetraboard-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../"
  },
  "workspaceFolder": "/workspace",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "tetraboard web",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "postCreateCommand": "pip install --no-cache-dir -r requirements-dev.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
